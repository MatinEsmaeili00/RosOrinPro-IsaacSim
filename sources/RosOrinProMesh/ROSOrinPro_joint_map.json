  "wheel_kinematics": {
    "equation": "omega_i = ((vx - wz*y_i)*ux_i + (vy + wz*x_i)*uy_i) / (r_i * ux_i)  ~= (vx - wz*y_i + s_i*(vy + wz*x_i)) / r_i for 45 deg rollers",
    "inputs": "vx, vy [m/s], wz [rad/s] = /odom twist (child frame base_footprint); omega_i [rad/s] about the wheel joint axis +Y; integrate omega_i*dt for the wheel joint position",
    "derivation": "the bottom roller spins freely about its own axis u_i, so the contact point velocity along u_i must equal the wheel-driven velocity (omega_i * r_i along +X) projected on u_i",
